rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Quản lý thông tin đăng ký tư vấn (Leads)
    // Cho phép khách vãng lai gửi yêu cầu, Admin có quyền xem và cập nhật trạng thái
    match /leads/{leadId} {
      allow create: if true;
      allow read, update, delete: if true;
    }

    // 2. Quản lý yêu cầu đặt lịch can thiệp 1-1 tại trung tâm (Booking Requests)
    // Cho phép khách gửi yêu cầu đặt lịch, Admin có quyền xem và xác nhận lịch hẹn
    match /bookingRequests/{requestId} {
      allow create: if true;
      allow read, update, delete: if true;
    }

    // 3. Quản lý hồ sơ người dùng (User Profiles)
    // Cho phép người dùng lưu thông tin khi đăng ký trên mọi thiết bị
    // Và cho phép bảng điều khiển Admin đọc toàn bộ danh sách để đồng bộ giữa các máy
    match /users/{userId} {
      allow read, write: if true;
    }

    // Chặn các đường dẫn chưa được khai báo
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
